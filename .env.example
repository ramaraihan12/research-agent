# Chat model. Ollama is the free default. For OpenAI, Gemini or Anthropic install the
# extra (uv sync --extra openai | gemini | anthropic), then set provider, model and key.
# Providers: ollama, openai, google_genai, anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434
LLM_API_KEY=
# Hosted models only: seconds per call, and attempts per call (1 means no retries).
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=1

# Where run checkpoints live. Empty keeps runs in memory, so `resume` won't find them
# after the process exits. Point it at Postgres to pause and resume runs, e.g.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_agent
DATABASE_URL=

# Search uses DuckDuckGo through ddgs. Set a key to use Tavily instead (uv sync --extra tavily).
TAVILY_API_KEY=

# Hard limits for one run
MAX_SUB_QUESTIONS=3
MAX_ROUNDS=2
MAX_PAGES=10
PAGES_PER_QUESTION=2
TOKEN_BUDGET=60000

# The public demo (research_agent.demo). The CLI and the local API ignore these, and these
# are the defaults. The demo itself runs with MAX_SUB_QUESTIONS=2, MAX_ROUNDS=1, MAX_PAGES=4,
# PAGES_PER_QUESTION=2 and TOKEN_BUDGET=20000.
# DEMO_RUNS_PER_DAY=10
# DEMO_RUNS_PER_IP_HOUR=2
# DEMO_RUNS_PER_IP_DAY=3
# DEMO_REQUESTS_PER_IP_MINUTE=30
# DEMO_MAX_SEARCH_CREDITS=3
# DEMO_MAX_MODEL_CALLS=18
# DEMO_RETRY_SECONDS=20
# DEMO_SLICE_SECONDS=240
# DEMO_MAX_SLICES=5
